<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net46</TargetFramework>
    <!-- The AGS editor only loads .NET plugins named AGS.Plugin.*.dll from its own folder. -->
    <AssemblyName>AGS.Plugin.Mcp</AssemblyName>
    <RootNamespace>AgsMcp.Editor</RootNamespace>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="Microsoft.VisualBasic" />
    <!-- Everything below ships with the editor: never copy it next to the plugin. -->
    <Reference Include="AGS.Types">
      <HintPath>$(AgsDir)\AGS.Types.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AGSEditor">
      <HintPath>$(AgsDir)\AGSEditor.exe</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(AgsDir)\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AgsMcp.Editor.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Build-time only: net46 reference assemblies, so machines without the .NET Framework 4.6 targeting
         pack (such as CI runners) can build. Nothing from this package ships with the plugin. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
